# ==============================================================================
# RegAI Production Environment Configuration (.env)
# ==============================================================================

# Project Name
PROJECT_NAME="RegAI Platform"
API_V1_STR="/api/v1"

# Security: Generate a 64-character random key using `openssl rand -hex 32`
SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS"
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM="HS256"

# Database Configuration (PostgreSQL 15)
POSTGRES_USER=regai_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=regai_db
DATABASE_URL="postgresql://regai_admin:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/regai_db"

# First Superuser (Auto-seeded if not existing)
FIRST_SUPERUSER_EMAIL="admin@yourdomain.com"
FIRST_SUPERUSER_PASSWORD="REPLACE_WITH_STRONG_ADMIN_PASSWORD"

# Vector Database & AI
EMBEDDINGS_PROVIDER="openai"
OPENAI_API_KEY=""
CHROMA_DIR="/app/chroma_db"

# Rate Limiting (Requests per minute per IP)
RATE_LIMIT_PER_MINUTE=120

# CORS & Allowed Domains (Array or comma-separated domains)
CORS_ORIGINS=["https://app.yourdomain.com","https://demo.yourdomain.com","http://localhost"]

# Logging
LOG_JSON=true
